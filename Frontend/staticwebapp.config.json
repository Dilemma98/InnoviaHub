{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*.{png,jpg,gif,svg,css,js}", "/favicon.ico"]
  },
  "mimeTypes": {
    ".json": "text/json",
    ".wasm": "application/wasm"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}